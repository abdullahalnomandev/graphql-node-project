{
  "name": "graphql-with-nodejs",
  "version": "1.0.0",
  "description": "Basic Node.js server setup with TypeScript and Express",
  "main": "dist/server.js",
  "scripts": {
    "build": "node init && tsc",
    "start": "node init && nodemon dist/server.js",
    "dev": "node init && ts-node-dev --respawn --transpile-only src/server.ts"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "graphql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-graphql": "^0.12.0",
    "graphql": "^17.0.2",
    "graphql-http": "^1.23.0",
    "mongoose": "^9.9.4",
    "nodemon": "^3.1.14"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
